# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=beekod_db

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
ADMIN_KEY=your_secure_admin_key_here

# ============================================
# AI SERVICES (Phase 9)
# ============================================
# Gemini API (Primary)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Google Custom Search (For Web Search Module)
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_CX=your_google_cse_cx


# ============================================
# SHIPPING PROVIDERS (Phase 10)
# ============================================
# Yurtiçi Kargo
YURTICI_API_KEY=your_yurtici_api_key
YURTICI_API_URL=https://api.yurticikargo.com/v1

# Aras Kargo
ARAS_API_KEY=your_aras_api_key
ARAS_API_URL=https://api.araskargo.com.tr/v1

# MNG Kargo
MNG_API_KEY=your_mng_api_key
MNG_API_URL=https://api.mngkargo.com.tr/v1

# ============================================
# EMAIL SERVICE (Phase 10)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Beekod <noreply@beekod.com>

# ============================================
# NOTIFICATION SETTINGS (Phase 10)
# ============================================
WEBHOOK_URL=https://your-webhook-url.com/notify
STOCK_ALERT_COOLDOWN=3600000
STOCK_ALERT_THRESHOLD=10

# ============================================
# REDIS CACHE (Optional - Phase 15)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Beekod

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here
CORS_ORIGIN=http://localhost:5173

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/beekod.log

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
